;; genre.xdy
;; --- RÈGLES DE TRI PERSONNALISÉES ---

;; 1. Ignorer la ponctuation parasite
;; L'ajout de :string empêche xindy de planter sur les caractères spéciaux
(merge-rule "« " "" :string)
(merge-rule "» " "" :string)
(merge-rule "«~~" "" :string)
(merge-rule "»~~" "" :string)
(merge-rule "[" "" :string)
(merge-rule "]" "" :string)

;; 2. Aplatir les lettres majuscules accentuées
(merge-rule "À" "A" :string)
(merge-rule "Â" "A" :string)
(merge-rule "É" "E" :string)
(merge-rule "È" "E" :string)
(merge-rule "Ê" "E" :string)
(merge-rule "Ë" "E" :string)
(merge-rule "Î" "I" :string)
(merge-rule "Ï" "I" :string)
(merge-rule "Ô" "O" :string)
(merge-rule "Û" "U" :string)
(merge-rule "Ç" "C" :string)

;; ------------------------------------
;; --- genre.xdy ---
(markup-indexentry :open "~n\nopagebreak\vspace*{6pt}~n\item \normalfont\bfseries " :depth 0)
;; Le \normalfont annule le gras du niveau 0
(markup-indexentry :open "~n \subitem \normalfont " :depth 1)
(markup-locclass-list :open "\hspace{6pt}\dotfill\hspace{6pt}" :sep ", ")
;; Désactivation des lettres
(define-letter-groups (""))
