;; corrigeauteurs.xdy
;; --- RÈGLES DE TRI PERSONNALISÉES ---

;; 1. Ignorer la ponctuation parasite
;; L'ajout de :string empêche xindy de planter sur les caractères spéciaux
(merge-rule "« " "" :string)
(merge-rule "» " "" :string)
(merge-rule "«~~" "" :string)
(merge-rule "»~~" "" :string)
(merge-rule "[" "" :string)
(merge-rule "]" "" :string)

;; 2. Aplatir les lettres majuscules accentuées
(merge-rule "À" "A" :string)
(merge-rule "Â" "A" :string)
(merge-rule "É" "E" :string)
(merge-rule "È" "E" :string)
(merge-rule "Ê" "E" :string)
(merge-rule "Ë" "E" :string)
(merge-rule "Î" "I" :string)
(merge-rule "Ï" "I" :string)
(merge-rule "Ô" "O" :string)
(merge-rule "Û" "U" :string)
(merge-rule "Ç" "C" :string)

;; ------------------------------------

;; ------------------------------------
;; Niveau 0 : Auteurs (en police normale, pas d'italique)
(markup-indexentry :open "~n\hfil~n\vspace{3pt plus 3pt}\item \normalfont " :depth 0)
;; Niveau 1 : Œuvres/Références (en italique)
;; On ouvre avec \itshape pour que tout le texte de l'entrée soit en italique
(markup-indexentry :open "~n\hfil~n\vspace{2pt}\subitem \normalfont\itshape " :close "~n\normalfont " :depth 1)
;; Niveau 2 : Sous-sous-entrées (en italique également)
(markup-indexentry :open "~n \small\subsubitem " :close "~n\normalfont " :depth 2)
;; Gestion des points de suite et des pages
(markup-locclass-list :open "\hspace{6pt}\dotfill\hspace{6pt}" :sep ", ")
;; Désactivation des en-têtes alphabétiques
(markup-locclass-list :open "\unskip\nobreak\dotfill\nobreak " :sep ", ")
(define-letter-groups (""))
